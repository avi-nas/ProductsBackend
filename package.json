{
  "name": "products-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the ProductsApp iOS catalogue.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "APP_ENV=dev tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:dev": "APP_ENV=dev node dist/server.js",
    "start:stage": "APP_ENV=stage node dist/server.js",
    "start:prod": "APP_ENV=prod node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "nodemailer": "10.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
